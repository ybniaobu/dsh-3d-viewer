{
  "name": "dsh-3d-viewer",
  "version": "0.2.1",
  "description": "Render FBX, OBJ, glTF, GLB, and STL models plus TGA, EXR, and HDR textures from the right Sidebar's workspace file tree in an orbitable view.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "3d-viewer",
    "texture",
    "tga",
    "exr",
    "hdr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ybniaobu/dsh-3d-viewer.git"
  },
  "homepage": "https://github.com/ybniaobu/dsh-3d-viewer#readme",
  "bugs": {
    "url": "https://github.com/ybniaobu/dsh-3d-viewer/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/client.js",
    "dist/client.*.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "icon.svg",
    "assets/hdri"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node tests/run.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "license": "MIT"
}
